# Optional. Copy to .env and export, or set in your shell.
# Claude (prompts_with_claude / qa.claude). Or run `ant auth login` instead of a key.
ANTHROPIC_API_KEY=
# OpenAI Images (source.provider: openai / cover.art.provider: openai)
OPENAI_API_KEY=
# Apify actor getascraper/kdp-book-niche-analyzer (niche run --source apify)
APIFY_TOKEN=
# Amazon Creators API (niche run --source creators). Needs an approved Associates account
# with >= 10 qualifying sales in the last 30 days. Access Key = client id, Secret Key = client secret.
CREATORS_CLIENT_ID=
CREATORS_CLIENT_SECRET=
CREATORS_PARTNER_TAG=
