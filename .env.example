# Copy to .env (gitignored) and fill in the keys you have. Shell variables override this file.
# Image generation for coloring-book interiors and cover art (interior.source.provider / cover.art.provider):
OPENAI_API_KEY=            # provider: openai   (gpt-image-1)
GEMINI_API_KEY=            # provider: google   (imagen-4.0-generate-001 via the Gemini API)
STABILITY_API_KEY=         # provider: stability (core | ultra | sd3.5-large)
POLLINATIONS_API_KEY=      # provider: pollinations works WITHOUT a key (low-res, watermark, weak quality); a free token raises limits
CF_ACCOUNT_ID=             # provider: cloudflare (Workers AI free daily allowance; flux-1-schnell)
CF_API_TOKEN=
# Claude for prompt variety, metadata, concept cards, story drafts and visual QA:
ANTHROPIC_API_KEY=
# Owner machines: skip the license check (do NOT ship this line to licensees)
KDP_STUDIO_DEV=1

# Nút "Gợi ý điền tất cả" ở trang Tạo sách: auto = Claude (nếu có ANTHROPIC_API_KEY) -> Cloudflare Workers AI (model văn bản) -> mẫu có sẵn
# KDP_STUDIO_SUGGEST=auto            # hoặc claude | cloudflare | offline
# KDP_STUDIO_CLAUDE_MODEL=claude-opus-5-5
# KDP_STUDIO_CF_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Tài khoản dự phòng: cùng tên biến + đuôi _2, _3 ... (tool tự chuyển sang khi tài khoản trước hết quota hay key bị từ chối)
# CF_ACCOUNT_ID_2=
# CF_API_TOKEN_2=
# OPENAI_API_KEY_2=
# Chuỗi dự phòng cho nguồn ảnh auto (bỏ trống = mọi tài khoản Cloudflare -> GPU cục bộ; nguồn trả tiền chỉ dùng khi bạn ghi vào đây)
# KDP_STUDIO_PROVIDER_CHAIN=cloudflare, cloudflare#2, local

